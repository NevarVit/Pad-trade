#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Слой 0: основной
        default_layer {
            display-name = "Default";
            bindings = <
                &kp TAB    &kp N1      &kp N2    &kp N4      &kp N8      &kp UP
                &kp LSHFT  &kp LC(C)   &kp LC(X) &kp LC(Z)   &kp LC(V)   &kp DOWN
                &mo 1      &kp LALT    &none     &kp SPACE   &kp LEFT    &kp RIGHT
            >;
        };

        work_layer {
            display-name = "Work";
            bindings = <
                &kp ESC    &kp F1    &kp F2   &kp F3    &kp F4    &kp BSPC
                &sk LCTRL      &kp E     &none    &kp C     &none     &kp U
                &none      &mo 2     &none    &kp N     &none     &kp M
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
                &none    &kp F1    &kp F2   &kp F3     &kp F4            &none
                &none    &none     &none    &none      &none             &none
                &none    &none     &none    &kp LCTRL  &studio_unlock    &bootloader 
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_3 {
            bindings = <&kp N3>;
            key-positions = <1 2>;
            layers = <0>;
        };

        combo_5 {
            bindings = <&kp N5>;
            key-positions = <1 3>;
            layers = <0>;
        };

        combo_6 {
            bindings = <&kp N6>;
            key-positions = <2 3>;
            layers = <0>;
        };

        combo_7 {
            bindings = <&kp N7>;
            key-positions = <1 2 3>;
            layers = <0>;
        };

        combo_9 {
            bindings = <&kp N9>;
            key-positions = <1 4>;
            layers = <0>;
        };

        combo_0 {
            bindings = <&kp N0>;
            key-positions = <2 4>;
            layers = <0>;
        };
    };
};