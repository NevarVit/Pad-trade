#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Слой 0: основной
        default_layer {
            display-name = "Default";
            bindings = <
                &kp TAB     &kp N1      &kp N2     &kp N4       &kp N8    &kp BSPC 
                &kp LSHFT   &kp LC(C)   &kp LC(X)  &kp LC(Z)    &kp LC(V) &kp DELETE  
                &kp LCTRL   &kp LALT    &none      &kp SPACE    &mo 2     &mo 1
            >;
        };

        work_layer {
            display-name = "Work";
            bindings = <
                &kp ESC    &kp UP    &none      &none   &kp HOME   &kp PG_UP   
                &kp LEFT   &kp DOWN  &kp RIGHT  &kp E    &kp END   &kp PG_DN        
                &none      &none     &none      &none    &none     &none
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
                &kp F1   &kp F2       &kp F3   &kp F4    &kp F5    &kp F6  
                &kp F7   &kp F8       &kp F9   &kp F10   &kp F11   &kp F12 
                &none    &bootloader  &none     &none    &none     &none   
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_3 {
            bindings = <&kp N3>;
            key-positions = <1 2>;
            layers = <0>;
        };

        combo_5 {
            bindings = <&kp N5>;
            key-positions = <1 3>;
            layers = <0>;
        };

        combo_6 {
            bindings = <&kp N6>;
            key-positions = <2 3>;
            layers = <0>;
        };

        combo_7 {
            bindings = <&kp N7>;
            key-positions = <1 2 3>;
            layers = <0>;
        };

        combo_9 {
            bindings = <&kp N9>;
            key-positions = <1 4>;
            layers = <0>;
        };

        combo_0 {
            bindings = <&kp N0>;
            key-positions = <2 4>;
            layers = <0>;
        };
    };
};